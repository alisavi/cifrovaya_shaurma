{
  "id": "practice-v1",
  "version": 1,
  "title": "Практика w1-hab: привычки и здоровье",
  "description": "Рубрика проверяет воспроизводимый наблюдательный анализ: паспорт источника, четыре блока признаков, очистку без заполнения средним, baseline → логистическая регрессия → permutation importance, факторы с направлением/силой/95% CI, отчёт с секцией «Традиционный способ» и осторожные выводы.",
  "scoring": {
    "statuses": { "ok": 1.0, "partial": 0.5, "missing": 0.0 },
    "pass_threshold": 0.8
  },
  "required_artifacts": [
    "works/w1-hab/spec.md",
    "works/w1-hab/data/PASSPORT.md",
    "works/w1-hab/out/metrics.json",
    "works/w1-hab/out/factors.csv",
    "works/w1-hab/report/report.html",
    "works/w1-hab/review/report.json"
  ],
  "criteria": [
    {
      "id": "passport",
      "weight": 0.12,
      "title": "Паспорт источника полон и проверен",
      "checks": [
        "есть ссылка на источник (URL или DOI)",
        "указана лицензия",
        "указан sha256",
        "фактический хеш файла совпадает с паспортом"
      ],
      "blocker": true
    },
    {
      "id": "structure",
      "weight": 0.06,
      "title": "Структура работы на месте",
      "checks": [
        "spec.md описывает вопрос, данные, метод и границы",
        "data/raw, out, report, review существуют",
        "есть fetch.sh или иной воспроизводимый способ получить данные"
      ]
    },
    {
      "id": "features",
      "weight": 0.15,
      "title": "Четыре блока признаков собраны",
      "checks": [
        "питание, сон, стресс, активность различены",
        "есть таблица соответствия колонок блокам",
        "целевая переменная определена явно"
      ]
    },
    {
      "id": "cleaning",
      "weight": 0.15,
      "title": "Очистка данных выполнена и описана",
      "checks": [
        "приведены типы",
        "учтены пропуски",
        "удалены/помечены дубликаты",
        "обработаны выбросы с указанием правил",
        "средним пропуски не заполнялись",
        "зафиксировано n до/после"
      ],
      "blocker": true
    },
    {
      "id": "modeling",
      "weight": 0.20,
      "title": "Baseline → логистическая регрессия → permutation importance",
      "checks": [
        "есть константный baseline",
        "есть логистическая регрессия с корректным train/test",
        "есть permutation importance",
        "указаны метрики и random_state"
      ]
    },
    {
      "id": "factors",
      "weight": 0.15,
      "title": "Факторы описаны направлением, силой и 95% CI",
      "checks": [
        "по каждому фактору есть направление",
        "есть мера силы",
        "есть 95% CI",
        "неинформативные факторы не выданы за значимые"
      ]
    },
    {
      "id": "report",
      "weight": 0.08,
      "title": "Отчёт читается человеком",
      "checks": [
        "report/report.html существует и открывается",
        "есть секция «Традиционный способ»",
        "результаты согласованы с out/metrics.json и out/factors.csv"
      ]
    },
    {
      "id": "causality",
      "weight": 0.05,
      "title": "Причинность не заявляется",
      "checks": [
        "выводы сформулированы как гипотезы/ассоциации",
        "указаны ограничения наблюдательных данных"
      ],
      "blocker": true
    },
    {
      "id": "reproducibility",
      "weight": 0.04,
      "title": "Результат воспроизводим",
      "checks": [
        "зафиксирован seed",
        "указаны версии библиотек",
        "есть скрипт загрузки данных"
      ]
    }
  ],
  "forbidden": [
    "причинные формулировки: «вызывает», «влияет», «приводит к»",
    "заполнение пропусков средним или медианой",
    "выдуманные ссылка, лицензия или sha256",
    "итоговая оценка, выставленная агентом вместо человека"
  ]
}
